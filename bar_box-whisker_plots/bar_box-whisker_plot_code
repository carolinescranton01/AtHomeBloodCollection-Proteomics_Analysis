# load packages
library(ggplot2)
library(patchwork)
library(ggpattern)

# Re-import matched data which is listed as one table, with columns Participant, ProteinID, Pathway, Category, and Log2FC (matching was done in excel)
data <- read_excel("~/path/to/data/kegg_data.xlsx")

# bar graph
kegg_bargraph <- ggplot(data, aes(x = Pathway, y = Log2FC, fill = Category)) + 
  geom_bar(stat = "identity") + theme_bw()+labs(x = "KEGG Pathway ID", y = "LogFC") +
  theme( axis.text.x=element_text(color = "black", size=8, angle=90, vjust=0.83, hjust=1), legend.position = "bottom")+ylim(-60000, 85000) + 
  theme(plot.title = element_text(size=30)) +
  labs(title="TITLE")

# IF NEEDED - facet_wrap by participant
kegg_bargraph + facet_wrap(~Participant)

print(kegg_bargraph)

# bar graph with boxplot overlay
kegg_boxbar <- ggplot(data, aes(x = Pathway, y = Log2FC, fill = Category)) + 
  geom_bar(stat = "identity", na.rm=T, alpha=1, position=position_identity()) + 
  theme_bw() +
  labs(x = "KEGG Pathway ID", y = "LogFC") + 
  theme(axis.text.x = element_text(color = "black", size = 12, angle = 90, vjust = 0.83, hjust = 1),axis.text.y = element_text(size = 12, color = "black"),legend.position = "bottom") +
  scale_y_continuous(limits = c(-5, 2.5)) +
  theme(plot.title = element_text(size=25)) +
  geom_point(aes(color = Category), position = position_dodge(width = 0.9), size = 1, shape = 21, fill = "black", alpha=0.8) +
  geom_boxplot(alpha=0.5, fill="white") +
  labs(title="TITLE") +
  theme(plot.title = element_text(size=25))+facet_wrap(~Participant)

print(kegg_boxbar)
