# Loading required libraries
library(PCAtest)
library(readxl)
library(ggfortify)
library(dplyr)
library(ggrepel)

# importing data (excel sheet of all samples (rows) + metadata per samples (first 9 columns) + measured proteins in remaining columns (with cells filled with either metadata or 
# protein detection in RFU)
data <- read_excel("~/path/to/data/data.xlsx")

# log 2 transform if not previously done (RFU data begins in column 9 and ends in column 7604)
data_log2 <- data %>%
  mutate(across(c(9:7604), ~ log(., base=2)))

# prcomp function to do principal components analysis + print summary
PCA1 <- prcomp(data_log2 [c(9:7604)])
summary(PCA1)

# PCA plot
PCA_plot <- autoplot(PCA1, data = data_log2, color="Person", shape="Type", size=2) + 
ggtitle("Title") +
theme(plot.title = element_text(hjust = 0.5))

PCA_plot

## replot, obscuring points with the sample name (column 'Label' in data)
PCA_labeled = PCA_plot +
geom_text_repel(aes(label = data$Label), size = 2, min.segment.length=0.25)

# nudge to offset labels from points
nudge <- position_nudge(y = 0.01)

# permanova test using adonis function (from vegan package) - example uses the Person column (corresponds to participant) and 999 permutations
permanova <- adonis(data_log2[c(9:7604)] ~ data$Person, permutations = 999)
print(permanova)

